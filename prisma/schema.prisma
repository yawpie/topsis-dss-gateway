// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id_user  Int    @id @default(autoincrement())
  nama     String @db.VarChar(255)
  username String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  role     String @db.VarChar(50)

  @@map("users")
}

model Alternatif {
  id_alternatif   Int     @id @default(autoincrement())
  kode_alternatif String  @unique @db.VarChar(50)
  nama_alternatif String  @db.VarChar(255)
  provinsi        String? @db.VarChar(255)

  nilai_alternatif NilaiAlternatif[]
  hasil_topsis     HasilTopsis?

  @@map("alternatif")
}

model Kriteria {
  id_kriteria   Int          @id @default(autoincrement())
  kode_kriteria String       @unique @db.VarChar(50)
  nama_kriteria String       @unique @db.VarChar(255)
  bobot         Decimal      @db.Decimal(18, 6)
  jenis         JenisKriteria

  nilai_alternatif NilaiAlternatif[]

  @@map("kriteria")
}

model NilaiAlternatif {
  id_nilai       Int     @id @default(autoincrement())
  id_alternatif  Int
  id_kriteria    Int
  nilai          Decimal @db.Decimal(18, 6)

  alternatif Alternatif @relation(fields: [id_alternatif], references: [id_alternatif], onDelete: Cascade, onUpdate: Cascade)
  kriteria   Kriteria   @relation(fields: [id_kriteria], references: [id_kriteria], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id_alternatif, id_kriteria])
  @@index([id_alternatif])
  @@index([id_kriteria])
  @@map("nilai_alternatif")
}

model HasilTopsis {
  id_hasil          Int     @id @default(autoincrement())
  id_alternatif     Int     @unique
  d_plus            Decimal @db.Decimal(18, 6)
  d_minus           Decimal @db.Decimal(18, 6)
  nilai_preferensi  Decimal @db.Decimal(18, 6)
  ranking           Int
  kategori          String  @db.VarChar(50)

  alternatif Alternatif @relation(fields: [id_alternatif], references: [id_alternatif], onDelete: Cascade, onUpdate: Cascade)

  @@index([id_alternatif])
  @@map("hasil_topsis")
}

enum JenisKriteria {
  BENEFIT
  COST
}
